GEMINI_API_KEY=your_gemini_api_key_here

# Optional: switch AI provider (gemini | claude | ollama)
AI_PROVIDER=gemini

# Optional: override Gemini model (default has a free tier)
GEMINI_MODEL=gemini-2.0-flash-lite

# Seconds to wait between Gemini requests (free tier: 30 RPM = 2s minimum, 3s is safe)
GEMINI_REQUEST_DELAY=3

# Required only if AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Required only if AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
